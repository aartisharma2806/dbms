/* =================================================
   SET 31
   ORDERINFO COLLECTION
   ================================================= */

/* CREATE DATABASE */

use collegeDB;


/* =================================================
   CREATE COLLECTION AND INSERT DOCUMENTS
   ================================================= */

db.orderinfo.insertMany([
{
    cust_id:123,
    cust_name:"abc",
    status:"A",
    price:250
},
{
    cust_id:124,
    cust_name:"amit",
    status:"B",
    price:400
},
{
    cust_id:125,
    cust_name:"neha",
    status:"A",
    price:500
}
]);


/* =================================================
   i. CUSTOMER NAME WITH PRICE
      BETWEEN 250 AND 450
   ================================================= */

db.orderinfo.find(
{
    price:{$gte:250,$lte:450}
},
{
    cust_name:1,
    _id:0
}
);


/* =================================================
   ii. INCREMENT / DECREMENT PRICE
   ================================================= */

/* INCREMENT BY 10 */

db.orderinfo.updateOne(
{
    cust_id:123
},
{
    $inc:{price:10}
}
);


/* DECREMENT BY 5 */

db.orderinfo.updateOne(
{
    cust_id:124
},
{
    $inc:{price:-5}
}
);


/* =================================================
   iii. REMOVE ONE DOCUMENT
   ================================================= */

db.orderinfo.deleteOne({
    cust_id:125
});


/* =================================================
   iv. CUSTOMER WHERE
   STATUS = 'A'
   OR PRICE = 250
   ================================================= */

db.orderinfo.find({
    $or:[
        {status:"A"},
        {price:250}
    ]
});
