/* =================================================
   i. MODIFY DATABASE
   ABC COMPANY NOW IN PUNE
   ================================================= */

UPDATE Company
SET city = 'Pune'
WHERE cname = 'ABC';

COMMIT;


/* =================================================
   ii. GIVE 10% RAISE TO MANAGERS
   IF SALARY > 20000 GIVE ONLY 3%
   ================================================= */

UPDATE works
SET sal =
(
    CASE
        WHEN sal > 20000 THEN sal + (sal * 0.03)
        ELSE sal + (sal * 0.10)
    END
);

COMMIT;


/* =================================================
   iii. FIND ALL EMPLOYEES
   WORKING IN BOSCH, PUNE
   ================================================= */

SELECT *
FROM works
WHERE cname = 'Bosch';


/* =================================================
   iv. DELETE WORKS RECORDS
   FOR SBC COMPANY
   WHERE SALARY > 30000
   ================================================= */

DELETE FROM works
WHERE cname = 'SBC Company'
AND sal > 30000;

COMMIT;
