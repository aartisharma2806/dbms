/* CREATE TABLES */

CREATE TABLE Emp (
    emp_id NUMBER PRIMARY KEY,
    ename VARCHAR2(30),
    street VARCHAR2(30),
    city VARCHAR2(30)
);

CREATE TABLE works (
    emp_id NUMBER,
    cid NUMBER,
    ename VARCHAR2(30),
    cname VARCHAR2(30),
    sal NUMBER(10,2)
);

CREATE TABLE Company (
    c_id NUMBER PRIMARY KEY,
    cname VARCHAR2(30),
    city VARCHAR2(30)
);

CREATE TABLE Manager (
    mgr_id NUMBER PRIMARY KEY,
    mgrname VARCHAR2(30)
);


