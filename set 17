

CREATE TABLE EMP (
    EMPNO NUMBER(5) PRIMARY KEY,
    ENAME VARCHAR2(30),
    SAL NUMBER(10,2),
    COMM NUMBER(10,2),
    DEPTNO NUMBER(5)
);

INSERT INTO EMP VALUES (101,'RAM',20000,2000,10);
INSERT INTO EMP VALUES (102,'SHYAM',25000,3000,20);
INSERT INTO EMP VALUES (103,'AMIT',30000,4000,30);

COMMIT;


SET SERVEROUTPUT ON;

DECLARE
    V_EMPNO EMP.EMPNO%TYPE := &EMPNO;
    
    V_SAL EMP.SAL%TYPE;
    V_COMM EMP.COMM%TYPE;
    V_DEPTNO EMP.DEPTNO%TYPE;

BEGIN

    

    SELECT SAL, COMM, DEPTNO
    INTO V_SAL, V_COMM, V_DEPTNO
    FROM EMP
    WHERE EMPNO = V_EMPNO;

  

    IF V_DEPTNO = 10 THEN

        V_SAL := V_SAL + (V_SAL * 10/100);

    ELSIF V_DEPTNO = 20 THEN

        V_SAL := V_SAL + (V_SAL * 15/100);

    ELSE

        V_SAL := V_SAL + V_COMM;

    END IF;

    

    UPDATE EMP
    SET SAL = V_SAL
    WHERE EMPNO = V_EMPNO;

    DBMS_OUTPUT.PUT_LINE('SALARY UPDATED');
    DBMS_OUTPUT.PUT_LINE('NEW SALARY = ' || V_SAL);

    COMMIT;

END;
/
