

CREATE TABLE BORROWER(
    ROLLIN NUMBER(5),
    NAME VARCHAR2(30),
    DATEOFISSUE DATE,
    NAMEOFBOOK VARCHAR2(50),
    STATUS CHAR(1)
);



CREATE TABLE FINE(
    ROLL_NO NUMBER(5),
    DT DATE,
    AMT NUMBER(10,2)
);



