SET SERVEROUTPUT ON;

DECLARE

    RNO NUMBER;
    BNAME VARCHAR2(50);

    ISSUE_DATE DATE;
    DAYS NUMBER;
    FINE_AMT NUMBER := 0;

BEGIN

    

    RNO := &RNO;
    BNAME := '&BNAME';

    

    SELECT DATEOFISSUE
    INTO ISSUE_DATE
    FROM BORROWER
    WHERE ROLLIN = RNO
    AND NAMEOFBOOK = BNAME;

    

    DAYS := TRUNC(SYSDATE - ISSUE_DATE);

    

    IF DAYS >= 15 AND DAYS <= 30 THEN

        FINE_AMT := DAYS * 5;

    ELSIF DAYS > 30 THEN

        FINE_AMT := DAYS * 50;

    ELSE

        FINE_AMT := 0;

    END IF;

    

    IF FINE_AMT > 0 THEN

        INSERT INTO FINE
        VALUES(RNO, SYSDATE, FINE_AMT);

    END IF;

    

    UPDATE BORROWER
    SET STATUS = 'R'
    WHERE ROLLIN = RNO
    AND NAMEOFBOOK = BNAME;

    

    DBMS_OUTPUT.PUT_LINE('BOOK SUBMITTED');
    DBMS_OUTPUT.PUT_LINE('TOTAL DAYS = ' || DAYS);
    DBMS_OUTPUT.PUT_LINE('FINE = ' || FINE_AMT);

    COMMIT;

EXCEPTION

    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('BOOK RECORD NOT FOUND');

    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('ERROR');

END;
