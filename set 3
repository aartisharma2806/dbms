/* =========================
   6. EMPLOYEE NAME AND
   ANNUAL SALARY
   SECOND LETTER = 'e'
   ========================= */

SELECT emp_name,
       salary * 12 AS annual_salary
FROM Employee
WHERE emp_name LIKE '_e%';


/* =========================
   7. UPDATE CITY TO PUNE
   FOR IT DEPARTMENT
   ========================= */

UPDATE Employee
SET city = 'Pune'
WHERE department =
(
    SELECT dept_id
    FROM Department
    WHERE dept_name = 'IT'
);

COMMIT;
