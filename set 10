1) Department-wise Total Salary Greater Than 2,00,000
SELECT department,
SUM(salary) AS Total_Salary
FROM Employee
GROUP BY department
HAVING SUM(salary) > 200000;

2) Department-wise Average Salary More Than 40,000
SELECT department,
AVG(salary) AS Average_Salary
FROM Employee
GROUP BY department
HAVING AVG(salary) > 40000;

3) Display City-wise Number of Employees
SELECT city,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY city;

4) Display Department-wise Maximum Salary
SELECT department,
MAX(salary) AS Maximum_Salary
FROM Employee
GROUP BY department;

5) Display City-wise Average Salary
SELECT city,
AVG(salary) AS Average_Salary
FROM Employee
GROUP BY city;

6) Department-wise Employee Count Greater Than 3
SELECT department,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY department
HAVING COUNT(*) > 3;

7) Display City-wise Employee Count in Ascending Order
SELECT city,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY city
ORDER BY Total_Employees ASC;
