SELECT department,
SUM(salary) AS Total_Salary
FROM Employee
GROUP BY department
HAVING SUM(salary) > 200000;

SELECT department,
AVG(salary) AS Average_Salary
FROM Employee
GROUP BY department
HAVING AVG(salary) > 40000;

SELECT city,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY city;

SELECT department,
MAX(salary) AS Maximum_Salary
FROM Employee
GROUP BY department;

SELECT city,
AVG(salary) AS Average_Salary
FROM Employee
GROUP BY city;

SELECT department,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY department
HAVING COUNT(*) > 3;

SELECT city,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY city
ORDER BY Total_Employees ASC;
