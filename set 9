1) Display Department-wise Total Salary
SELECT department,
SUM(salary) AS Total_Salary
FROM Employee
GROUP BY department;

2) Display Department-wise Average Salary
SELECT department,
AVG(salary) AS Average_Salary
FROM Employee
GROUP BY department;

3) City-wise Employee Count Greater Than 3
SELECT city,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY city
HAVING COUNT(*) > 3;

4) Department-wise Maximum Salary Above 60000
SELECT department,
MAX(salary) AS Maximum_Salary
FROM Employee
GROUP BY department
HAVING MAX(salary) > 60000;

5) Display Department and City-wise Total Salary
SELECT department,
city,
SUM(salary) AS Total_Salary
FROM Employee
GROUP BY department, city;

6) Display Departments Having More Than One Employee
SELECT department,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY department
HAVING COUNT(*) > 1;

7) Display City-wise Employee Count in Descending Order
SELECT city,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY city
ORDER BY Total_Employees DESC;
