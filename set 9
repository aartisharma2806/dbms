SELECT department,
SUM(salary) AS Total_Salary
FROM Employee
GROUP BY department;

SELECT department,
AVG(salary) AS Average_Salary
FROM Employee
GROUP BY department;

SELECT city,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY city
HAVING COUNT(*) > 3;

SELECT department,
MAX(salary) AS Maximum_Salary
FROM Employee
GROUP BY department
HAVING MAX(salary) > 60000;

SELECT department,
city,
SUM(salary) AS Total_Salary
FROM Employee
GROUP BY department, city;

SELECT department,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY department
HAVING COUNT(*) > 1;

SELECT city,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY city
ORDER BY Total_Employees DESC;
