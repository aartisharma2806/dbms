COMMIT;


DECLARE
    CURSOR c_top IS
        SELECT emp_id, emp_name, salary
        FROM Employee
        ORDER BY salary DESC;

    v_empid   Employee.emp_id%TYPE;
    v_ename   Employee.emp_name%TYPE;
    v_salary  Employee.salary%TYPE;

    n NUMBER := 3;   -- Top N salaries
    counter NUMBER := 0;

BEGIN
    OPEN c_top;

    LOOP
        FETCH c_top INTO v_empid, v_ename, v_salary;

        EXIT WHEN c_top%NOTFOUND OR counter = n;

        DBMS_OUTPUT.PUT_LINE(
            'Emp ID: ' || v_empid ||
            ' Name: ' || v_ename ||
            ' Salary: ' || v_salary
        );

        counter := counter + 1;
    END LOOP;

    CLOSE c_top;
END;
/
