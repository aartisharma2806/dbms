2) Update Salary and Rollback
UPDATE Employees
SET salary = salary + 5000
WHERE employee_id = 101;

ROLLBACK;

3) Savepoint SP1, Update Salary, Rollback to SP1
SAVEPOINT SP1;

UPDATE Employees
SET salary = salary + 2000
WHERE employee_id = 102;

ROLLBACK TO SP1;

4) Multiple Savepoints
SAVEPOINT A;

UPDATE Employees
SET salary = salary + 1000
WHERE employee_id = 101;

SAVEPOINT B;

UPDATE Employees
SET salary = salary + 2000
WHERE employee_id = 102;

ROLLBACK TO B;

5) Delete Employee Record and Commit
DELETE FROM Employees
WHERE employee_id = 103;

COMMIT;
