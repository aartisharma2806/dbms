SET SERVEROUTPUT ON;

DECLARE
    N NUMBER;
    
    NEGATIVE_NUMBER EXCEPTION;

BEGIN

    /* INPUT FROM USER */
    N := &N;

    /* CHECK NEGATIVE NUMBER */
    IF N < 0 THEN
        RAISE NEGATIVE_NUMBER;
    END IF;

    /* CHECK ODD OR EVEN */
    IF MOD(N,2) = 0 THEN
        DBMS_OUTPUT.PUT_LINE('NUMBER IS EVEN');
    ELSE
        DBMS_OUTPUT.PUT_LINE('NUMBER IS ODD');
    END IF;

EXCEPTION

    WHEN NEGATIVE_NUMBER THEN
        DBMS_OUTPUT.PUT_LINE('NEGATIVE NUMBER NOT ALLOWED');

END;
/
