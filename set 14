SELECT E.JOB_ID AS JOB,
       E.MANAGER_ID AS MGR,
       E.SALARY AS SAL,
       E.COMMISSION_PCT AS COMM,
       D.DEPARTMENT_NAME AS DNAME
FROM EMPLOYEES E
JOIN DEPARTMENT D
ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
WHERE E.JOB_ID = 'SALESMAN';


SELECT E.FIRST_NAME || ' ' || E.LAST_NAME AS ENAME,
       E.JOB_ID AS JOB,
       E.DEPARTMENT_ID AS DEPTNO,
       D.DEPARTMENT_NAME AS DNAME
FROM EMPLOYEES E
JOIN DEPARTMENT D
ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
WHERE D.LOCATION_ID = 'PUNE';



SELECT E.FIRST_NAME || ' ' || E.LAST_NAME AS ENAME,
       D.DEPARTMENT_NAME AS DNAME
FROM EMPLOYEES E
RIGHT OUTER JOIN DEPARTMENT D
ON E.DEPARTMENT_ID = D.DEPARTMENT_ID;



SELECT E.FIRST_NAME || ' ' || E.LAST_NAME AS ENAME,
       D.DEPARTMENT_NAME AS DNAME
FROM EMPLOYEES E
FULL OUTER JOIN DEPARTMENT D
ON E.DEPARTMENT_ID = D.DEPARTMENT_ID;

SELECT E.EMPLOYEE_ID AS EMPNO,
       E.FIRST_NAME || ' ' || E.LAST_NAME AS ENAME,
       D.LOCATION_ID AS LOC
FROM EMPLOYEES E
JOIN DEPARTMENT D
ON E.DEPARTMENT_ID = D.DEPARTMENT_ID
WHERE E.JOB_ID = 'CLERK';
