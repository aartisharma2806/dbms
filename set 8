1) Highest, Lowest, Sum and Average Salary
SELECT MAX(salary) AS Highest_Salary,
MIN(salary) AS Lowest_Salary,
SUM(salary) AS Total_Salary,
AVG(salary) AS Average_Salary
FROM Employee;

2) Number of People with Same Job
SELECT job_id,
COUNT(*) AS Total_Employees
FROM Employee
GROUP BY job_id;

3) Number of Managers Without Listing Them
SELECT COUNT(DISTINCT manager_id)
AS Number_Of_Managers
FROM Employee;

4) Difference Between Highest and Lowest Salary
SELECT MAX(salary)-MIN(salary)
AS DIFFERENCE
FROM Employee;

5) Manager Number and Lowest Salary Under That Manager
SELECT manager_id,
MIN(salary) AS Lowest_Salary
FROM Employee
GROUP BY manager_id;
