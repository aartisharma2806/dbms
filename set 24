/* =================================================
   1. EMPLOYEES WITH SALARY GREATER
      THAN ANY EMPLOYEE IN DEPT 30
   ================================================= */

SELECT FIRST_NAME, SALARY
FROM Employees
WHERE SALARY > ANY
(
    SELECT SALARY
    FROM Employees
    WHERE DEPARTMENT_ID = 30
);


/* =================================================
   2. EMPLOYEES WITH SALARY GREATER
      THAN ALL EMPLOYEES IN DEPT 20
   ================================================= */

SELECT FIRST_NAME, SALARY
FROM Employees
WHERE SALARY > ALL
(
    SELECT SALARY
    FROM Employees
    WHERE DEPARTMENT_ID = 20
);


/* =================================================
   3. EMPLOYEES WORKING IN DEPARTMENTS
      WHERE JOB IS MANAGER
   ================================================= */

SELECT *
FROM Employees
WHERE DEPARTMENT_ID IN
(
    SELECT DEPARTMENT_ID
    FROM Employees
    WHERE JOB_ID = 'MANAGER'
);


/* =================================================
   4. EMPLOYEES WITH SALARY GREATER
      THAN AVERAGE OF THEIR DEPARTMENT
   ================================================= */

SELECT E1.FIRST_NAME,
       E1.SALARY,
       E1.DEPARTMENT_ID
FROM Employees E1
WHERE E1.SALARY >
(
    SELECT AVG(E2.SALARY)
    FROM Employees E2
    WHERE E1.DEPARTMENT_ID = E2.DEPARTMENT_ID
);


/* =================================================
   5. EMPLOYEES WITH HIGHEST SALARY
      IN THEIR DEPARTMENT
   ================================================= */

SELECT E1.FIRST_NAME,
       E1.SALARY,
       E1.DEPARTMENT_ID
FROM Employees E1
WHERE E1.SALARY =
(
    SELECT MAX(E2.SALARY)
    FROM Employees E2
    WHERE E1.DEPARTMENT_ID = E2.DEPARTMENT_ID
);


/* =================================================
   6. EMPLOYEES HAVING SAME JOB AS
      AT LEAST ONE EMPLOYEE IN DEPT 20
   ================================================= */

SELECT FIRST_NAME, JOB_ID
FROM Employees
WHERE JOB_ID = ANY
(
    SELECT JOB_ID
    FROM Employees
    WHERE DEPARTMENT_ID = 20
);
