CREATE OR REPLACE TRIGGER trg_library_update
BEFORE UPDATE ON Library
FOR EACH ROW
BEGIN
    INSERT INTO Library_Audit (
        book_id,
        old_book_name,
        old_author,
        old_price,
        operation_type,
        action_date
    )
    VALUES (
        :OLD.book_id,
        :OLD.book_name,
        :OLD.author,
        :OLD.price,
        'UPDATE',
        SYSDATE
    );
END;
/

CREATE OR REPLACE TRIGGER trg_library_delete
BEFORE DELETE ON Library
FOR EACH ROW
BEGIN
    INSERT INTO Library_Audit (
        book_id,
        old_book_name,
        old_author,
        old_price,
        operation_type,
        action_date
    )
    VALUES (
        :OLD.book_id,
        :OLD.book_name,
        :OLD.author,
        :OLD.price,
        'DELETE',
        SYSDATE
    );
END;
/

