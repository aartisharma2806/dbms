3) Update City to Pune for Employees Working in IT Department
UPDATE Employee
SET city='Pune'
WHERE department=
(
SELECT dept_id
FROM Department
WHERE dept_name='IT'
);

4) Delete Employees Whose Salary is Greater than 100000
DELETE FROM Employee
WHERE salary > 100000;

5) Display Employee Name and Salary After Deducting 5% Tax
SELECT emp_name,
salary - (salary*0.05) AS salary_after_tax
FROM Employee;

6) Display Employees Who Do Not Live in Mumbai and Name Starts with 'A'
SELECT *
FROM Employee
WHERE city <> 'Mumbai'
AND emp_name LIKE 'A%';

7) Display Employees Belonging to IT Department Having Salary Greater than 50000
SELECT *
FROM Employee
WHERE department=
(
SELECT dept_id
FROM Department
WHERE dept_name='IT'
)
AND salary > 50000;
