/* =========================
   3. UPDATE CITY TO PUNE
   FOR IT DEPARTMENT
   ========================= */

UPDATE Employee
SET city = 'Pune'
WHERE department =
(
    SELECT dept_id
    FROM Department
    WHERE dept_name = 'IT'
);

COMMIT;


/* =========================
   4. DELETE EMPLOYEES
   SALARY > 100000
   ========================= */

DELETE FROM Employee
WHERE salary > 100000;

COMMIT;


/* =========================
   5. DISPLAY EMPLOYEE NAME
   AND SALARY AFTER 5% TAX
   ========================= */

SELECT emp_name,
       salary - (salary * 0.05) AS salary_after_tax
FROM Employee;


/* =========================
   6. EMPLOYEES NOT IN
   MUMBAI AND NAME START A
   ========================= */

SELECT *
FROM Employee
WHERE city <> 'Mumbai'
AND emp_name LIKE 'A%';


/* =========================
   7. EMPLOYEES IN IT
   DEPARTMENT WITH
   SALARY > 50000
   ========================= */

SELECT *
FROM Employee
WHERE department =
(
    SELECT dept_id
    FROM Department
    WHERE dept_name = 'IT'
)
AND salary > 50000;
