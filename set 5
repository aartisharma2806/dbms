/* =========================
   1. CREATE NEW USER
   ========================= */

CREATE USER Class_div_rollno
IDENTIFIED BY password123;


/* =========================
   2. GRANT SELECT
   ON EMPLOYEE TABLE
   ========================= */

GRANT SELECT
ON Employee
TO Class_div_rollno;


/* =========================
   3. GRANT INSERT AND UPDATE
   ON EMPLOYEE TABLE
   ========================= */

GRANT INSERT, UPDATE
ON Employee
TO Class_div_rollno;


/* =========================
   4. REVOKE UPDATE
   FROM user1
   ========================= */

REVOKE UPDATE
ON Employee
FROM user1;


/* =========================
   5. CREATE ROLE
   ========================= */

CREATE ROLE manager_role;


/* =========================
   6. GRANT SELECT AND DELETE
   TO manager_role
   ========================= */

GRANT SELECT, DELETE
ON Employee
TO manager_role;


/* =========================
   7. REVOKE ROLE
   FROM user2
   ========================= */

REVOKE manager_role
FROM user2;
