1) Create a New User
CREATE USER Class_div_rollno
IDENTIFIED BY password;

2) Grant SELECT Permission on Employee Table
GRANT SELECT
ON Employee
TO Class_div_rollno;

3) Grant INSERT and UPDATE Permissions
GRANT INSERT, UPDATE
ON Employee
TO Class_div_rollno;

4) Revoke UPDATE Permission from user1
REVOKE UPDATE
ON Employee
FROM user1;

5) Create Role manager_role
CREATE ROLE manager_role;

6) Grant SELECT and DELETE Privileges to manager_role
GRANT SELECT, DELETE
ON Employee
TO manager_role;

7) Revoke manager_role from user2
REVOKE manager_role
FROM user2;
