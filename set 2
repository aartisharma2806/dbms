1) Display cname, acc_type, amount of customers having Saving account
SELECT Cname, Acc_Type, Amount
FROM Customer NATURAL JOIN Account
WHERE Acc_Type='Saving';

2) Display data using Natural, Left and Right Join
Natural Join
SELECT *
FROM Customer NATURAL JOIN Account;

Left Join
SELECT *
FROM Customer
LEFT JOIN Account
ON Customer.C_Id=Account.C_Id;

Right Join
SELECT *
FROM Customer
RIGHT JOIN Account
ON Customer.C_Id=Account.C_Id;

3) Display customers living in same city as Pooja
SELECT *
FROM Customer
WHERE City=
(
SELECT City
FROM Customer
WHERE Cname='Pooja'
);

4) Display accounts having amount less than average amount
SELECT *
FROM Account
WHERE Amount <
(
SELECT AVG(Amount)
FROM Account
);

5) Display C_Id having maximum amount
SELECT C_Id
FROM Account
WHERE Amount=
(
SELECT MAX(Amount)
FROM Account
);

6) Display amount and acc_type having minimum amount of that acc_type
SELECT Amount, Acc_Type
FROM Account A
WHERE Amount=
(
SELECT MIN(Amount)
FROM Account
WHERE Acc_Type=A.Acc_Type
);

7) Display accounts whose amount is higher than ANY saving account amount
SELECT Amount
FROM Account
WHERE Amount > ANY
(
SELECT Amount
FROM Account
WHERE Acc_Type='Saving'
);
