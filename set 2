Customer Table
CREATE TABLE Customer(
    C_Id NUMBER PRIMARY KEY,
    Cname VARCHAR2(20),
    City VARCHAR2(20)
);

Account Table
CREATE TABLE Account(
    C_Id NUMBER,
    Acc_Type VARCHAR2(20),
    Amount NUMBER,
    FOREIGN KEY(C_Id) REFERENCES Customer(C_Id)
);

