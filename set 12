DEPARTMENT_NAME, LOC
FROM Employees
NATURAL JOIN Departments;


SELECT e.JOB_ID,
       e.MANAGER_ID,
       e.SALARY,
       e.COMMISSION_PCT,
       d.DEPARTMENT_NAME
FROM Employees e
JOIN Departments d
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID
WHERE e.JOB_ID = 'SALESMAN';



SELECT FIRST_NAME, JOB_ID,
e.DEPARTMENT_ID, DEPARTMENT_NAME
FROM Employees e
JOIN Departments d
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID
WHERE LOC = 'DALLAS';



SELECT EMPLOYEE_ID, FIRST_NAME,
JOB_ID, DEPARTMENT_NAME
FROM Employees e
LEFT OUTER JOIN Departments d
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID
ORDER BY EMPLOYEE_ID;



