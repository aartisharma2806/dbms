CREATE TABLE empl (
    empno NUMBER,
    ename VARCHAR2(20),
    sal NUMBER(10,2),
    deptno NUMBER
);


ALTER TABLE empl
ADD CONSTRAINT empl_pk PRIMARY KEY (empno);

-- Ename not null
ALTER TABLE empl
MODIFY ename CONSTRAINT empl_ename_nn NOT NULL;

-- Check salary > 10000
ALTER TABLE empl
ADD CONSTRAINT empl_sal_ck CHECK (sal > 10000);

-- Deptno foreign key
ALTER TABLE empl
ADD CONSTRAINT empl_dept_fk
FOREIGN KEY (deptno)
REFERENCES dept1(deptno);


