/* CREATE DATABASE */

use collegeDB;


/* CREATE COLLECTION AND INSERT DOCUMENTS */

db.orderinfo.insertMany([
{
    cust_id:123,
    cust_name:"abc",
    status:"A",
    price:250
},
{
    cust_id:124,
    cust_name:"amit",
    status:"B",
    price:500
},
{
    cust_id:125,
    cust_name:"neha",
    status:"A",
    price:1200
},
{
    cust_id:126,
    cust_name:"rohit",
    status:"A",
    price:700
}
]);


/* =================================================
   1. AVERAGE PRICE
   FOR STATUS 'A'
   ================================================= */

db.orderinfo.aggregate([
{
    $match:{status:"A"}
},
{
    $group:{
        _id:null,
        average_price:{$avg:"$price"}
    }
}
]);


/* =================================================
   2. CUSTOMERS HAVING AMOUNT
   BETWEEN 100 AND 1000
   ================================================= */

db.orderinfo.find({
    price:{$gte:100,$lte:1000}
});


/* =================================================
   3. DISPLAY CUSTOMER
   INFORMATION WITHOUT _id
   ================================================= */

db.orderinfo.find(
{},
{
    _id:0
}
);


/* =================================================
   4. CREATE SIMPLE INDEX
   ================================================= */

db.orderinfo.createIndex({cust_id:1});
