DESC SALGRADE;



SELECT e.FIRST_NAME,
       e.JOB_ID,
       d.DEPARTMENT_NAME,
       e.SALARY,
       s.GRADE
FROM Employees e
JOIN Departments d
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID
JOIN SALGRADE s
ON e.SALARY BETWEEN s.LOSAL AND s.HISAL;


SELECT e.FIRST_NAME,
       e.SALARY,
       e.MANAGER_ID,
       d.DEPARTMENT_NAME
FROM Employees e
JOIN Departments d
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID
WHERE e.SALARY > 2000;



SELECT e.EMPLOYEE_ID,
       e.FIRST_NAME,
       e.JOB_ID,
       e.DEPARTMENT_ID,
       d.DEPARTMENT_NAME,
       d.LOC
FROM Employees e
LEFT OUTER JOIN Departments d
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID;



SELECT e.FIRST_NAME,
       d.DEPARTMENT_NAME
FROM Employees e
RIGHT OUTER JOIN Departments d
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID;



SELECT e.EMPLOYEE_ID,
       d.DEPARTMENT_NAME,
       d.LOC
FROM Employees e
FULL OUTER JOIN Departments d
ON e.DEPARTMENT_ID = d.DEPARTMENT_ID;



